{% schema %}
{
  "name": "Pixel Helper",
  "target": "body",
  "stylesheet": "pixel-helper-theme.css",
  "javascript": "pixel-helper-theme.js",
  "settings": [
    {
      "type": "text",
      "id": "pixel_id",
      "label": "Pixel ID"
    },
    {
      "type": "checkbox",
      "id": "enable_helper",
      "label": "Show Pixel Helper in Theme",
      "default": true
    }
  ]
}
{% endschema %}

{% if block.settings.enable_helper %}
  <!-- Pixel Helper Container in Storefront Theme -->
  <div id="shopify-theme-pixel-helper-root" data-pixel-id="{{ block.settings.pixel_id }}"></div>
{% endif %}
